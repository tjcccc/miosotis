{
  "name": "miosotis",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Local-first, AI-managed personal knowledge system",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "miosotis": "dist/index.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "miosotis": "node dist/index.js",
    "gen:schemas": "pnpm build && node scripts/gen-schemas.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "markdown-it": "^15.0.2",
    "smol-toml": "^1.9.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
