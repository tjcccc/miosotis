{
  "$id": "miosotis.enrichment.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "miosotis.enrichment.v1"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200,
      "pattern": "^[\\x21-\\x7e]+$",
      "description": "Client-chosen key; replaying the same request with it returns the original receipt."
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "input_digest": {
          "type": "string",
          "minLength": 1,
          "description": "Copy from `enrich prepare`; binds this result to the exact revision"
        }
      },
      "required": [
        "id",
        "version",
        "input_digest"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "abstract": {
      "description": "What the source says, not what it proves",
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "language": {
      "description": "BCP-47 tag of the main language",
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "terms": {
      "default": [],
      "description": "Retrieval terms. Include useful synonyms and translations in other languages the user may search in.",
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "entities": {
      "default": [],
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "project_suggestions": {
      "default": [],
      "description": "IDs (P-…) of existing projects only; stored as inferred, never overriding explicit membership",
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assertions": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "The claim, briefly, in the source's own terms"
          },
          "holder": {
            "type": "string",
            "enum": [
              "user",
              "quoted_author",
              "group",
              "unknown"
            ],
            "description": "Who asserts it. A quoted article's claim is not the user's belief."
          },
          "modality": {
            "type": "string",
            "enum": [
              "explicit",
              "tentative",
              "quoted",
              "inferred"
            ],
            "description": "How strongly and directly it is asserted"
          }
        },
        "required": [
          "text",
          "holder",
          "modality"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "description": "How much of the text was actually read",
      "type": "object",
      "properties": {
        "read_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "read_chars",
        "total_chars"
      ],
      "additionalProperties": false
    },
    "interpretations": {
      "default": [],
      "description": "Image interpretations by a vision-capable host, each bound to the exact image bytes",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "sha256 of the image payload you looked at (from source get)"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "What the image shows, factually"
          },
          "transcription": {
            "description": "Visible text, transcribed verbatim; omit what you cannot read",
            "type": "string",
            "maxLength": 20000
          },
          "observations": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "legibility": {
                  "type": "string",
                  "enum": [
                    "clear",
                    "uncertain"
                  ],
                  "description": "uncertain = partly unreadable; never guess numbers"
                }
              },
              "required": [
                "text",
                "legibility"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "payload_sha256",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "model": {
      "description": "Model name only if the host reports it reliably; otherwise omit",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "source_ref"
  ],
  "additionalProperties": false
}
