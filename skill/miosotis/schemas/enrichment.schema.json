{
  "$id": "miosotis.enrichment.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "miosotis.enrichment.v1"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200,
      "pattern": "^[\\x21-\\x7e]+$",
      "description": "Client-chosen key; replaying the same request with it returns the original receipt."
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "input_digest": {
          "type": "string",
          "minLength": 1,
          "description": "Copy from `enrich prepare`; binds this result to the exact revision"
        }
      },
      "required": [
        "id",
        "version",
        "input_digest"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "abstract": {
      "description": "What the source says, not what it proves",
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "language": {
      "description": "BCP-47 tag of the main language",
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "terms": {
      "default": [],
      "description": "Retrieval terms. Include useful synonyms and translations in other languages the user may search in.",
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "entities": {
      "default": [],
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "project_suggestions": {
      "default": [],
      "description": "IDs (P-…) of existing projects only; stored as inferred, never overriding explicit membership",
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assertions": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "The claim, briefly, in the source's own terms"
          },
          "holder": {
            "type": "string",
            "enum": [
              "user",
              "quoted_author",
              "group",
              "unknown"
            ],
            "description": "Who asserts it. A quoted article's claim is not the user's belief."
          },
          "modality": {
            "type": "string",
            "enum": [
              "explicit",
              "tentative",
              "quoted",
              "inferred"
            ],
            "description": "How strongly and directly it is asserted"
          }
        },
        "required": [
          "text",
          "holder",
          "modality"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "description": "How much of the text was actually read",
      "type": "object",
      "properties": {
        "read_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "read_chars",
        "total_chars"
      ],
      "additionalProperties": false
    },
    "interpretations": {
      "default": [],
      "description": "Image interpretations by a vision-capable host, each bound to the exact image bytes",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "sha256 of the image payload you looked at (from source get)"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "What the image shows, factually"
          },
          "transcription": {
            "description": "Visible text, transcribed verbatim; omit what you cannot read",
            "type": "string",
            "maxLength": 20000
          },
          "observations": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "legibility": {
                  "type": "string",
                  "enum": [
                    "clear",
                    "uncertain"
                  ],
                  "description": "uncertain = partly unreadable; never guess numbers"
                }
              },
              "required": [
                "text",
                "legibility"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "payload_sha256",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "default": [],
      "description": "Dated arrangements the source states (meetings, appointments). Resolve relative dates from received_at and timezone in `enrich prepare`. Send them again on every re-enrichment.",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "What it is, in the user's words (e.g. 'Roadmap discussion')"
          },
          "start": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Local calendar date, YYYY-MM-DD"
              },
              "time": {
                "description": "Only when the source states a clock time",
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "part_of_day": {
                "description": "When the source says e.g. 'morning' but no clock time; never invent a time",
                "type": "string",
                "enum": [
                  "morning",
                  "afternoon",
                  "evening",
                  "night"
                ]
              }
            },
            "required": [
              "date"
            ],
            "additionalProperties": false
          },
          "end": {
            "description": "Only when the source states an end",
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Local calendar date, YYYY-MM-DD"
              },
              "time": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "description": "Local 24-hour time, HH:MM"
              }
            },
            "additionalProperties": false
          },
          "timezone": {
            "description": "IANA zone of the stated times; defaults to the zone the source was saved in",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "phrase": {
            "description": "The words in the source that state the time, copied exactly",
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "repeat": {
            "description": "Only when the source states a repeating plan ('every Monday'); start.date is the first possible date",
            "type": "object",
            "properties": {
              "every": {
                "type": "string",
                "enum": [
                  "day",
                  "week",
                  "month"
                ]
              },
              "interval": {
                "default": 1,
                "description": "Every N days/weeks/months (default 1)",
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "on": {
                "description": "Weekly: the weekdays (default: start.date's weekday)",
                "minItems": 1,
                "maxItems": 7,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "monday",
                    "tuesday",
                    "wednesday",
                    "thursday",
                    "friday",
                    "saturday",
                    "sunday"
                  ]
                }
              },
              "month_day": {
                "description": "Monthly: the day of the month (-1 = last day; default: start.date's day)",
                "type": "integer",
                "minimum": -1,
                "maximum": 31
              },
              "month_weekday": {
                "description": "Monthly: e.g. the first Monday ({nth: 1, weekday: monday}) or the last Friday (nth: -1)",
                "type": "object",
                "properties": {
                  "nth": {
                    "type": "integer",
                    "minimum": -1,
                    "maximum": 5
                  },
                  "weekday": {
                    "type": "string",
                    "enum": [
                      "monday",
                      "tuesday",
                      "wednesday",
                      "thursday",
                      "friday",
                      "saturday",
                      "sunday"
                    ]
                  }
                },
                "required": [
                  "nth",
                  "weekday"
                ],
                "additionalProperties": false
              },
              "until": {
                "description": "Last possible date (inclusive)",
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "count": {
                "description": "Number of occurrences",
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            },
            "required": [
              "every"
            ],
            "additionalProperties": false
          },
          "replaces": {
            "description": "V-… of an earlier event this one reschedules",
            "type": "string",
            "minLength": 1
          },
          "occurrence": {
            "description": "With replaces on a repeating event: the one date this event replaces. Without it, the series is replaced from this event's start on",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "title",
          "start"
        ],
        "additionalProperties": false
      }
    },
    "cancels": {
      "default": [],
      "description": "Events this source cancels: \"V-…\", {event, date} for one occurrence, or {event, from} to end a series",
      "maxItems": 20,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "description": "V-…: the whole event (or series)"
          },
          {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "description": "Only this occurrence",
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "from": {
                "description": "This and every later occurrence",
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "event"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "warnings": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "model": {
      "description": "Model name only if the host reports it reliably; otherwise omit",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "source_ref"
  ],
  "additionalProperties": false
}
