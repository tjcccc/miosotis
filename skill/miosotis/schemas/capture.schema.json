{
  "$id": "miosotis.capture.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "miosotis.capture.v1"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200,
      "pattern": "^[\\x21-\\x7e]+$",
      "description": "Client-chosen key; replaying the same request with it returns the original receipt."
    },
    "text": {
      "type": "string",
      "maxLength": 1000000,
      "description": "Content to preserve verbatim. Never rewritten."
    },
    "origin": {
      "default": "user",
      "description": "user = authored by the user; imported = quoted or pasted material; ai_saved = AI output the user chose to keep",
      "type": "string",
      "enum": [
        "user",
        "imported",
        "ai_saved"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Project slug (any script); created on save if new"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "supplied_url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "published": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 4,
              "maxLength": 40,
              "description": "Date as reported: YYYY, YYYY-MM, YYYY-MM-DD, or an instant"
            },
            "precision": {
              "type": "string",
              "enum": [
                "year",
                "month",
                "day",
                "instant"
              ]
            }
          },
          "required": [
            "value",
            "precision"
          ],
          "additionalProperties": false
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false,
      "description": "Observable origin metadata for imported or quoted material. Not a reliability judgement."
    },
    "client_captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 instant with offset or Z"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "IANA timezone, e.g. Europe/Berlin"
    }
  },
  "required": [
    "text"
  ],
  "additionalProperties": false
}
